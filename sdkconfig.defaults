# Required by espressif/esp_peer for WebRTC DTLS-SRTP.
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_SSL_DTLS_SRTP=y

# Required by esp_peer's self-signed certificate generation on ESP-IDF 6.x.
CONFIG_MBEDTLS_X509_CREATE_C=y

# Doubao's HTTP Upgrade response can exceed ESP-IDF's 1 KiB default.
CONFIG_WS_BUFFER_SIZE=8192
CONFIG_WS_DYNAMIC_BUFFER=y

# Leave enough CPU headroom for concurrent camera preview and realtime audio.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Keep camera DMA/event handling away from Wi-Fi and realtime audio on CPU0.
CONFIG_CAMERA_CORE1=y
CONFIG_CAMERA_PSRAM_DMA=y

# This board exposes UART0 through its CH343 USB-UART bridge (COM12).
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
